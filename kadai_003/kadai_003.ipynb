            "行列の積 C:\n",
            "[[ 4  5  6  7]\n",
            " [12 17 22 27]\n",
            " [20 29 38 47]]\n",
            "行列 C の最大値:\n",
            "47\n"
          ]
        }
      ],
      "source": [
        "import numpy as np\n",
        "\n",
        "A = np.array([[0, 1], [2, 3], [4, 5]])\n",
        "\n",
        "B = np.array([[0, 1, 2, 3], [4, 5, 6, 7]])\n",
        "\n",
        "C = np.dot(A, B)  # または C = A @ B\n",
        "\n",
        "print(\"行列の積 C:\")\n",
        "print(C)\n",
        "\n",
        "max_value = C.max()\n",
        "print(\"行列 C の最大値:\")\n",
        "print(max_value)"
      ]
    }
  ]
}